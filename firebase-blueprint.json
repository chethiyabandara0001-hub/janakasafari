{
  "entities": {
    "SiteImage": {
      "title": "SiteImage",
      "description": "Represents an image slot on one of the 12 Nisha Safari pages, storing strictly the Cloudflare R2 CDN URL (never raw image data) and metadata.",
      "type": "object",
      "properties": {
        "slotId": {
          "type": "string",
          "description": "Unique deterministic ID for the slot, e.g. index_html__slot_0",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 120
        },
        "page": {
          "type": "string",
          "description": "HTML filename, e.g. index.html or yala-safari.html",
          "maxLength": 80
        },
        "slotIndex": {
          "type": "number",
          "description": "0-based slot index on the page"
        },
        "type": {
          "type": "string",
          "enum": ["hero-bg", "img", "lightbox-img", "logo"],
          "description": "Kind of image slot"
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for the slot",
          "maxLength": 300
        },
        "sectionContext": {
          "type": "string",
          "description": "Section heading context on the page",
          "maxLength": 300
        },
        "src": {
          "type": "string",
          "description": "Cloudflare R2 CDN URL or web URL for the image (never raw data: URI)",
          "maxLength": 2048
        },
        "lightboxHref": {
          "type": "string",
          "description": "Optional full-size lightbox R2 CDN URL",
          "maxLength": 2048
        },
        "r2Key": {
          "type": "string",
          "description": "Optional Cloudflare R2 storage bucket object key",
          "maxLength": 512
        },
        "alt": {
          "type": "string",
          "description": "Accessible alt text for the image",
          "maxLength": 500
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "description": "Public visibility flag for query rules"
        },
        "authorId": {
          "type": "string",
          "description": "UID of the admin who created/updated the image slot",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "slotId",
        "page",
        "slotIndex",
        "type",
        "label",
        "sectionContext",
        "src",
        "alt",
        "visibility",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SectionGalleryItem": {
      "title": "SectionGalleryItem",
      "description": "A wildlife or safari showcase photo added to a specific page section, storing strictly the Cloudflare R2 CDN link and metadata.",
      "type": "object",
      "properties": {
        "itemId": {
          "type": "string",
          "description": "Unique identifier for the section gallery photo",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 120
        },
        "page": {
          "type": "string",
          "description": "HTML page filename, e.g. index.html or yala-safari.html",
          "maxLength": 80
        },
        "sectionKey": {
          "type": "string",
          "description": "Identifier of the section on the page",
          "maxLength": 120
        },
        "sectionTitle": {
          "type": "string",
          "description": "Display heading of the section",
          "maxLength": 200
        },
        "title": {
          "type": "string",
          "description": "Photo title",
          "maxLength": 200
        },
        "caption": {
          "type": "string",
          "description": "Photo caption or description",
          "maxLength": 1000
        },
        "src": {
          "type": "string",
          "description": "Cloudflare R2 CDN URL for the photo (never raw data: URI)",
          "maxLength": 2048
        },
        "r2Key": {
          "type": "string",
          "description": "Optional Cloudflare R2 storage bucket object key",
          "maxLength": 512
        },
        "alt": {
          "type": "string",
          "description": "Accessible alt text",
          "maxLength": 500
        },
        "order": {
          "type": "number",
          "description": "Display sort order within the section"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "description": "Public visibility flag"
        },
        "authorId": {
          "type": "string",
          "description": "Admin UID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "itemId",
        "page",
        "sectionKey",
        "sectionTitle",
        "title",
        "caption",
        "src",
        "alt",
        "order",
        "visibility",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "SiteText": {
      "title": "SiteText",
      "description": "Represents an editable or newly added text element on any of the 12 website pages.",
      "type": "object",
      "properties": {
        "textId": {
          "type": "string",
          "description": "Unique deterministic ID for the text element, e.g. index_html__text_0",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 120
        },
        "page": {
          "type": "string",
          "description": "HTML page filename, e.g. index.html",
          "maxLength": 80
        },
        "textIndex": {
          "type": "number",
          "description": "0-based index of the text node on the page, or -1 for custom added text blocks"
        },
        "tagName": {
          "type": "string",
          "enum": ["H1", "H2", "H3", "H4", "P", "SPAN", "A", "LI", "DIV", "BLOCKQUOTE", "STRONG", "TD", "CUSTOM"],
          "description": "HTML tag type of the text element"
        },
        "sectionContext": {
          "type": "string",
          "description": "Section heading context on the page",
          "maxLength": 300
        },
        "content": {
          "type": "string",
          "description": "The text content to display",
          "maxLength": 10000
        },
        "isDeleted": {
          "type": "boolean",
          "description": "Whether this text element has been deleted/hidden by the admin"
        },
        "isCustomAdded": {
          "type": "boolean",
          "description": "Whether this text block was newly added by the admin"
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "description": "Public visibility flag"
        },
        "authorId": {
          "type": "string",
          "description": "Admin UID",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": [
        "textId",
        "page",
        "textIndex",
        "tagName",
        "sectionContext",
        "content",
        "isDeleted",
        "isCustomAdded",
        "visibility",
        "authorId",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized CMS administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "maxLength": 256
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "createdAt", "updatedAt"]
    },
    "Enquiry": {
      "title": "Enquiry",
      "description": "Represents a customer tour or taxi service enquiry submitted from the website contact form.",
      "type": "object",
      "properties": {
        "enquiryId": {
          "type": "string",
          "description": "Unique identifier for the enquiry, e.g. enq_1731480000000_abc123",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "maxLength": 120
        },
        "firstName": {
          "type": "string",
          "description": "Guest first name",
          "minLength": 1,
          "maxLength": 100
        },
        "lastName": {
          "type": "string",
          "description": "Guest last name",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "description": "Guest email address",
          "minLength": 3,
          "maxLength": 256
        },
        "whatsapp": {
          "type": "string",
          "description": "Guest WhatsApp or phone number",
          "maxLength": 60
        },
        "park": {
          "type": "string",
          "description": "Preferred national park or destination",
          "maxLength": 100
        },
        "adults": {
          "type": "string",
          "description": "Number of adult guests",
          "minLength": 1,
          "maxLength": 20
        },
        "kids": {
          "type": "string",
          "description": "Number of child guests",
          "minLength": 1,
          "maxLength": 20
        },
        "safariDate": {
          "type": "string",
          "description": "Preferred travel or taxi service date",
          "maxLength": 60
        },
        "message": {
          "type": "string",
          "description": "Detailed enquiry message from the guest",
          "minLength": 1,
          "maxLength": 4000
        },
        "status": {
          "type": "string",
          "enum": ["new", "read", "replied"],
          "description": "Workflow status of the enquiry in the admin panel"
        },
        "sourcePage": {
          "type": "string",
          "description": "Page from which the enquiry was submitted",
          "minLength": 1,
          "maxLength": 80
        },
        "adminScope": {
          "type": "string",
          "enum": ["nisha-cms-admin"],
          "description": "Relational scope identifier for admin panel queries"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last update timestamp"
        }
      },
      "required": [
        "enquiryId",
        "firstName",
        "lastName",
        "email",
        "whatsapp",
        "park",
        "adults",
        "kids",
        "safariDate",
        "message",
        "status",
        "sourcePage",
        "adminScope",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/site_images/{slotId}": {
      "schema": {
        "$ref": "#/entities/SiteImage"
      },
      "description": "Stores Cloudflare R2 CDN links and metadata for all page image slots"
    },
    "/section_gallery_items/{itemId}": {
      "schema": {
        "$ref": "#/entities/SectionGalleryItem"
      },
      "description": "Stores Cloudflare R2 CDN links and metadata for section wildlife gallery photos"
    },
    "/site_texts/{textId}": {
      "schema": {
        "$ref": "#/entities/SiteText"
      },
      "description": "Stores live overrides, additions, and deletions for all site text elements"
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Stores authorized admin UIDs"
    },
    "/enquiries/{enquiryId}": {
      "schema": {
        "$ref": "#/entities/Enquiry"
      },
      "description": "Stores customer enquiries submitted via the Contact page for review in the Admin Panel"
    }
  }
}

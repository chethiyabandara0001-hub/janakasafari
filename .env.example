# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloudflare R2 Storage Bucket Configuration
# R2_ACCOUNT_ID: Cloudflare Account ID (defaults to 10382badc5549c70cccebce858ee7f65)
R2_ACCOUNT_ID=""
# R2_BUCKET_NAME: Cloudflare R2 Bucket Name (defaults to ai-studio-applet-opennext-cache)
R2_BUCKET_NAME="ai-studio-applet-opennext-cache"
# R2_API_TOKEN: Optional Cloudflare API Token with R2 Storage Read & Write permissions
R2_API_TOKEN=""
# R2_ACCESS_KEY_ID & R2_SECRET_ACCESS_KEY: Optional S3-compatible R2 API keys
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# NEXT_PUBLIC_R2_PUBLIC_URL: Optional public custom domain or r2.dev CDN base URL for the R2 bucket (defaults to /api/r2/file)
NEXT_PUBLIC_R2_PUBLIC_URL=""

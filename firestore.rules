rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Common Security & Domain Primitives
    // ===============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.email == "nishasafari@gmail.com" ||
          (
            request.auth.token.email_verified == true &&
            request.auth.token.email == "chethiyabandara0001@gmail.com"
          ) ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidId(id) {
      return id is string &&
        id.size() >= 1 &&
        id.size() <= 120 &&
        id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isBoundedString(val, min, max) {
      return val is string && val.size() >= min && val.size() <= max;
    }

    // Enforces that Firestore only stores R2 / web CDN links, never raw base64 data: URIs
    function isCdnUrl(val, min, max) {
      return isBoundedString(val, min, max) && !val.matches('^data:.*');
    }

    // ===============================================================
    // Entity Blueprint Validators (hasOnly + Type + Bounds + Regex)
    // ===============================================================

    function isValidSiteImage(data, docId) {
      return data.keys().hasAll([
          'slotId',
          'page',
          'slotIndex',
          'type',
          'label',
          'sectionContext',
          'src',
          'alt',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'slotId',
          'page',
          'slotIndex',
          'type',
          'label',
          'sectionContext',
          'src',
          'lightboxHref',
          'r2Key',
          'alt',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.slotId == docId &&
        isValidId(data.slotId) &&
        isBoundedString(data.page, 1, 80) &&
        data.slotIndex is number &&
        data.slotIndex >= 0 &&
        data.slotIndex <= 1000 &&
        data.type in ['hero-bg', 'img', 'lightbox-img', 'logo'] &&
        isBoundedString(data.label, 0, 300) &&
        isBoundedString(data.sectionContext, 0, 300) &&
        isCdnUrl(data.src, 1, 2048) &&
        (!('lightboxHref' in data) || isCdnUrl(data.lightboxHref, 0, 2048)) &&
        (!('r2Key' in data) || isBoundedString(data.r2Key, 1, 512)) &&
        isBoundedString(data.alt, 0, 500) &&
        data.visibility == 'public' &&
        isBoundedString(data.authorId, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSectionGalleryItem(data, docId) {
      return data.keys().hasAll([
          'itemId',
          'page',
          'sectionKey',
          'sectionTitle',
          'title',
          'caption',
          'src',
          'alt',
          'order',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'itemId',
          'page',
          'sectionKey',
          'sectionTitle',
          'title',
          'caption',
          'src',
          'r2Key',
          'alt',
          'order',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.itemId == docId &&
        isValidId(data.itemId) &&
        isBoundedString(data.page, 1, 80) &&
        isBoundedString(data.sectionKey, 1, 120) &&
        isBoundedString(data.sectionTitle, 1, 200) &&
        isBoundedString(data.title, 1, 200) &&
        isBoundedString(data.caption, 0, 1000) &&
        isCdnUrl(data.src, 1, 2048) &&
        (!('r2Key' in data) || isBoundedString(data.r2Key, 1, 512)) &&
        isBoundedString(data.alt, 0, 500) &&
        data.order is number &&
        data.order >= 0 &&
        data.order <= 10000 &&
        data.visibility == 'public' &&
        isBoundedString(data.authorId, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSiteText(data, docId) {
      return data.keys().hasAll([
          'textId',
          'page',
          'textIndex',
          'tagName',
          'sectionContext',
          'content',
          'isDeleted',
          'isCustomAdded',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'textId',
          'page',
          'textIndex',
          'tagName',
          'sectionContext',
          'content',
          'isDeleted',
          'isCustomAdded',
          'visibility',
          'authorId',
          'createdAt',
          'updatedAt'
        ]) &&
        data.textId == docId &&
        isValidId(data.textId) &&
        isBoundedString(data.page, 1, 80) &&
        data.textIndex is number &&
        data.textIndex >= -1 &&
        data.textIndex <= 5000 &&
        data.tagName in ['H1', 'H2', 'H3', 'H4', 'P', 'SPAN', 'A', 'LI', 'DIV', 'BLOCKQUOTE', 'STRONG', 'TD', 'CUSTOM'] &&
        isBoundedString(data.sectionContext, 0, 300) &&
        isBoundedString(data.content, 0, 10000) &&
        data.isDeleted is bool &&
        data.isCustomAdded is bool &&
        data.visibility == 'public' &&
        isBoundedString(data.authorId, 1, 128) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminUser(data, adminUid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt', 'updatedAt']) &&
        data.uid == adminUid &&
        isBoundedString(data.uid, 1, 128) &&
        isBoundedString(data.email, 3, 256) &&
        data.role == 'admin' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isAuthorizedCmsAuthor(authorId) {
      return (isAdmin() && authorId == request.auth.uid) || authorId == 'nisha-cms-admin';
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /site_images/{slotId} {
      allow get: if resource == null || existing().visibility == 'public' || isAdmin();
      allow list: if existing().visibility == 'public' || isAdmin();

      allow create: if isValidSiteImage(incoming(), slotId) &&
        isAuthorizedCmsAuthor(incoming().authorId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidSiteImage(incoming(), slotId) &&
        isAuthorizedCmsAuthor(incoming().authorId) &&
        incoming().slotId == existing().slotId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isAdmin() || existing().authorId == 'nisha-cms-admin';
    }

    match /section_gallery_items/{itemId} {
      allow get: if resource == null || existing().visibility == 'public' || isAdmin();
      allow list: if existing().visibility == 'public' || isAdmin();

      allow create: if isValidSectionGalleryItem(incoming(), itemId) &&
        isAuthorizedCmsAuthor(incoming().authorId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidSectionGalleryItem(incoming(), itemId) &&
        isAuthorizedCmsAuthor(incoming().authorId) &&
        incoming().itemId == existing().itemId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isAdmin() || existing().authorId == 'nisha-cms-admin';
    }

    match /site_texts/{textId} {
      allow get: if resource == null || existing().visibility == 'public' || isAdmin();
      allow list: if existing().visibility == 'public' || isAdmin();

      allow create: if isValidSiteText(incoming(), textId) &&
        isAuthorizedCmsAuthor(incoming().authorId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidSiteText(incoming(), textId) &&
        isAuthorizedCmsAuthor(incoming().authorId) &&
        incoming().textId == existing().textId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isAdmin() || existing().authorId == 'nisha-cms-admin';
    }

    match /admins/{adminUid} {
      // Strictly isolate PII (admin email) to the owner or verified admins; never allow public list
      allow get: if (isSignedIn() && request.auth.uid == adminUid) || isAdmin();
      allow list: if false;

      allow create: if isAdmin() &&
        isValidAdminUser(incoming(), adminUid) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isAdmin() &&
        isValidAdminUser(incoming(), adminUid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;

      allow delete: if isAdmin();
    }

    // Default-Deny Catch-All Rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

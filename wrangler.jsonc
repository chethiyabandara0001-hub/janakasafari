{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "janakasafari",
  "main": ".cloudflare/worker.mjs",
  "compatibility_date": "2025-04-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".cloudflare/assets",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "ai-studio-applet-opennext-cache"
    }
  ]
}

